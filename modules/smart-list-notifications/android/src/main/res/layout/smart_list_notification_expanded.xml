<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/smart_list_notification_card"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:id="@+id/notification_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="2"
    android:textColor="#FF101C37"
    android:textSize="16sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/notification_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:ellipsize="end"
    android:maxLines="3"
    android:textColor="#FF39445B"
    android:textSize="13sp" />

  <TextView
    android:id="@+id/notification_distance"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/smart_list_notification_distance"
    android:paddingStart="10dp"
    android:paddingTop="7dp"
    android:paddingEnd="10dp"
    android:paddingBottom="7dp"
    android:textColor="#FF24468D"
    android:textSize="11sp"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginTop="10dp"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/item_1"
      style="@style/SmartListNotificationTile"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="4dp"
      android:layout_weight="1">
      <TextView
        android:id="@+id/item_1_icon"
        style="@style/SmartListNotificationTileIcon" />
      <TextView
        android:id="@+id/item_1_name"
        style="@style/SmartListNotificationTileName" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/item_2"
      style="@style/SmartListNotificationTile"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:layout_weight="1">
      <TextView
        android:id="@+id/item_2_icon"
        style="@style/SmartListNotificationTileIcon" />
      <TextView
        android:id="@+id/item_2_name"
        style="@style/SmartListNotificationTileName" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/item_3"
      style="@style/SmartListNotificationTile"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="4dp"
      android:layout_marginEnd="4dp"
      android:layout_weight="1">
      <TextView
        android:id="@+id/item_3_icon"
        style="@style/SmartListNotificationTileIcon" />
      <TextView
        android:id="@+id/item_3_name"
        style="@style/SmartListNotificationTileName" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/item_overflow"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="4dp"
      android:layout_weight="1"
      android:background="@drawable/smart_list_notification_primary_button"
      android:gravity="center"
      android:orientation="vertical"
      android:padding="4dp">
      <TextView
        android:id="@+id/item_overflow_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/item_overflow_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="10sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="12dp"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/action_open_list"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="4dp"
      android:layout_weight="1"
      android:background="@drawable/smart_list_notification_primary_button"
      android:gravity="center"
      android:text="▤  Abrir Lista"
      android:textColor="#FFFFFFFF"
      android:textSize="12sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/action_snooze"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="4dp"
      android:layout_weight="1"
      android:background="@drawable/smart_list_notification_secondary_button"
      android:gravity="center"
      android:text="◷  Adiar 30 min"
      android:textColor="#FF26385B"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/action_dismiss"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_gravity="start"
    android:layout_marginTop="3dp"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:text="Dispensar"
    android:textColor="#FF39445B"
    android:textSize="12sp" />
</LinearLayout>
